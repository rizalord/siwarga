includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: max

    # Read casts from the casts() method body so date/decimal casts resolve correctly.
    parseModelCastsMethod: true
