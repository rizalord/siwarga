---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicApi } from '../lib/api';

export const prerender = true;

const page = await publicApi.getPage('profil-komplek');

const profilFallback =
  '<p>Rumah-rumah di Asabri Bumiayu Indah tersusun rapat dalam blok-blok yang saling ' +
  'terhubung lewat jalan lingkungan yang mudah dilalui. Kepadatan ini justru menjadi ' +
  'kekuatan sosial kami — antartetangga saling kenal, saling menjaga, dan terlibat ' +
  'aktif dalam kegiatan RT, mulai dari kerja bakti bulanan hingga perayaan hari besar ' +
  'nasional di lapangan RT.</p>' +
  '<p>Pengelolaan lingkungan dijalankan oleh pengurus RT bersama warga secara gotong ' +
  'royong: menjaga kebersihan saluran air, keamanan lingkungan, hingga fasilitas ' +
  'umum yang dipakai bersama.</p>';

const fasilitas = [
  { title: 'Pos Keamanan 24 Jam', desc: 'Penjagaan bergantian oleh petugas dan ronda warga di setiap blok.' },
  { title: 'Lapangan Serbaguna', desc: 'Titik kumpul kerja bakti, upacara, dan acara warga sepanjang tahun.' },
  { title: 'Pos Kesehatan', desc: 'Lokasi posyandu balita dan lansia yang berjalan rutin tiap bulan.' },
  { title: 'Saluran & Drainase Terawat', desc: 'Perawatan rutin saluran air untuk lingkungan yang bebas banjir.' },
];
---

<BaseLayout title="Profil Komplek" active="profil">
  <section class="page-hero section-white">
    <div class="wrap">
      <p class="page-hero__kicker text-soft">Profil Kompleks</p>
      <h1 class="page-hero__title">{page?.title ?? 'Perum Asabri Bumiayu Indah'}</h1>
      <p class="page-hero__lede text-soft">
        Kompleks perumahan yang berlokasi di Kelurahan Bumiayu, Kecamatan Kedungkandang,
        Kota Malang — dibangun oleh Asabri dan kini dihuni serta dirawat bersama oleh
        warganya lintas generasi.
      </p>
    </div>
  </section>

  <section class="section-paper band">
    <div class="wrap prose-block hairline">
      <h2>Lingkungan yang padat, tertata, dan bersahabat</h2>
      <div class="prose-block-body" set:html={page?.content ?? profilFallback} />
    </div>
  </section>

  <section class="section-white band">
    <div class="wrap">
      <h2 class="section-title">Fasilitas Lingkungan</h2>
      <div class="fasilitas-grid">
        {
          fasilitas.map((f) => (
            <div class="fasilitas-item">
              <h3>{f.title}</h3>
              <p class="text-soft">{f.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-black band">
    <div class="wrap closing-cta">
      <h2>Ingin tahu lebih lanjut soal lingkungan kami?</h2>
      <a class="pill pill--light" href="/kontak">Hubungi Pengurus RT</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 7vw, 4.5rem) 2.5rem;
  }
  .page-hero__kicker {
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  .page-hero__title {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }
  .page-hero__lede {
    font-size: 1.08rem;
    max-width: 60ch;
  }

  .band {
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }

  .prose-block {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    max-width: 72ch;
    padding-top: 2.5rem;
  }
  .prose-block h2 {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
  }
  .prose-block p {
    font-size: 1.03rem;
  }
  .prose-block-body p {
    color: var(--gray-500);
    font-size: 1.03rem;
    margin-bottom: 1.3rem;
  }

  .section-title {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    margin-bottom: 2rem;
  }

  .fasilitas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem 2.4rem;
  }
  .fasilitas-item {
    padding-top: 1.2rem;
    border-top: 1px solid var(--gray-300);
  }
  .fasilitas-item h3 {
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }
  .fasilitas-item p {
    font-size: 0.96rem;
  }

  .closing-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }
  .closing-cta h2 {
    color: var(--white);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  @media (max-width: 640px) {
    .fasilitas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
