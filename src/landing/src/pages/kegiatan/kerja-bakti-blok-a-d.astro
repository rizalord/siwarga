---
import BaseLayout from '../../layouts/BaseLayout.astro';

const galeri = [1, 2, 3, 4, 5, 6];
---

<BaseLayout title="Kerja Bakti Bersama Warga Blok A–D" active="kegiatan">
  <article class="event section-white">
    <header class="event__header wrap">
      <a class="back-link" href="/kegiatan">← Semua kegiatan</a>
      <span class="event__tag text-soft">Lingkungan</span>
      <h1>Kerja Bakti Bersama Warga Blok A–D</h1>
      <time class="event__date text-soft tnum">10 Agustus 2026 · 07.00 WIB</time>
    </header>

    <div class="event__body wrap">
      <p>
        Gotong royong membersihkan saluran air dan merapikan fasilitas umum di sekitar
        Blok A hingga D. Seluruh warga diundang untuk berpartisipasi — datang langsung
        ke titik kumpul di lapangan RT.
      </p>
    </div>

    <div class="wrap">
      <h2 class="galeri-title">Galeri Dokumentasi</h2>
      <div class="galeri-grid">
        {
          galeri.map((n) => (
            <div class="galeri-item">
              <span class="galeri-item__label">Foto kegiatan #{n}</span>
              <span class="galeri-item__note text-soft">Menyusul dari pengurus RT</span>
            </div>
          ))
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .event__header {
    padding-block: clamp(2.4rem, 6vw, 3.2rem) 2rem;
    border-bottom: 1px solid var(--gray-300);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .back-link {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 0.4rem;
  }
  .event__tag {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .event__header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    max-width: 34ch;
    letter-spacing: -0.03em;
  }
  .event__date {
    font-size: 0.92rem;
    font-weight: 500;
  }

  .event__body {
    max-width: 68ch;
    padding-block: 2rem 1rem;
    font-size: 1.05rem;
  }

  .galeri-title {
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    letter-spacing: -0.02em;
    margin-block: 2rem 1.4rem;
  }

  .galeri-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    padding-bottom: 4.5rem;
  }

  .galeri-item {
    aspect-ratio: 4 / 3;
    background: var(--paper);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    text-align: center;
    padding: 1rem;
  }
  .galeri-item__label {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }
  .galeri-item__note {
    font-size: 0.78rem;
  }

  @media (max-width: 780px) {
    .galeri-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 460px) {
    .galeri-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
