---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoCard from '../../components/InfoCard.astro';

const kegiatan = [
  {
    href: '/kegiatan/kerja-bakti-blok-a-d',
    title: 'Kerja Bakti Bersama Warga Blok A–D',
    excerpt: 'Gotong royong membersihkan saluran dan area fasilitas umum di sekitar Blok A hingga D.',
    date: '10 Agu 2026',
    tag: 'Lingkungan',
    isNew: true,
  },
  {
    href: '/kegiatan/hut-ri-81',
    title: 'Peringatan HUT RI ke-81 di Lapangan RT',
    excerpt: 'Upacara bendera, lomba warga, dan panggung hiburan untuk seluruh keluarga.',
    date: '17 Agu 2026',
    tag: 'Perayaan',
  },
  {
    href: '/kegiatan/posyandu-bulanan',
    title: 'Posyandu Balita & Lansia Bulanan',
    excerpt: 'Pemeriksaan kesehatan rutin untuk balita dan lansia, bertempat di pos kesehatan RT.',
    date: '5 Agu 2026',
    tag: 'Kesehatan',
  },
  {
    href: '/kegiatan/arisan-ibu-ibu',
    title: 'Arisan & Silaturahmi Ibu-Ibu RT',
    excerpt: 'Pertemuan rutin bulanan ibu-ibu warga sekaligus ajang arisan dan silaturahmi.',
    date: '2 Agu 2026',
    tag: 'Sosial',
  },
];
---

<BaseLayout title="Kegiatan" active="kegiatan">
  <section class="page-hero section-white">
    <div class="wrap">
      <p class="page-hero__kicker text-soft">Kegiatan Warga</p>
      <h1 class="page-hero__title">Daftar Kegiatan</h1>
      <p class="page-hero__lede text-soft">
        Agenda dan dokumentasi kegiatan warga Perum Asabri Bumiayu Indah, dari kerja bakti
        hingga perayaan bersama.
      </p>
    </div>
  </section>

  <section class="section-paper band">
    <div class="wrap card-grid">
      {kegiatan.map((item) => <InfoCard {...item} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 7vw, 4.5rem) 2.5rem;
  }
  .page-hero__kicker {
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  .page-hero__title {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }
  .page-hero__lede {
    font-size: 1.08rem;
    max-width: 58ch;
  }
  .band {
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  @media (max-width: 860px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
