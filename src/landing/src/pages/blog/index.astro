---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoCard from '../../components/InfoCard.astro';

const pengumuman = [
  {
    href: '/blog/kerja-bakti-bulanan-minggu-pertama',
    title: 'Jadwal Kerja Bakti Bulanan — Minggu Pertama',
    excerpt:
      'Kerja bakti rutin dimulai pukul 07.00 di titik kumpul Blok A. Warga dimohon membawa alat kebersihan masing-masing.',
    date: '3 Agu 2026',
    tag: 'Lingkungan',
    isNew: true,
  },
  {
    href: '/blog/perbaikan-saluran-air-blok-c',
    title: 'Perbaikan Saluran Air di Blok C',
    excerpt:
      'Perbaikan saluran akan berlangsung 2 hari. Mohon maaf atas ketidaknyamanan selama pengerjaan berlangsung.',
    date: '28 Jul 2026',
    tag: 'Fasilitas',
  },
  {
    href: '/blog/pengumuman-iuran-bulanan',
    title: 'Iuran Bulanan & Batas Waktu Pembayaran',
    excerpt:
      'Pembayaran iuran bulan berjalan paling lambat tanggal 10. Pembayaran dapat dilakukan ke bendahara RT.',
    date: '25 Jul 2026',
    tag: 'Keuangan',
  },
  {
    href: '/blog/jadwal-ronda-malam',
    title: 'Jadwal Ronda Malam Bulan Agustus',
    excerpt: 'Pembagian jadwal ronda malam per blok untuk menjaga keamanan lingkungan bersama.',
    date: '20 Jul 2026',
    tag: 'Keamanan',
  },
  {
    href: '/blog/vaksinasi-lansia',
    title: 'Layanan Vaksinasi Lansia di Pos Kesehatan',
    excerpt: 'Kerja sama dengan puskesmas setempat untuk layanan vaksinasi lansia setiap bulan.',
    date: '14 Jul 2026',
    tag: 'Kesehatan',
  },
  {
    href: '/blog/pemadaman-listrik-terjadwal',
    title: 'Pemberitahuan Pemadaman Listrik Terjadwal',
    excerpt: 'Pemadaman bergilir dari PLN akan berlangsung selama 2 jam di area sekitar kompleks.',
    date: '9 Jul 2026',
    tag: 'Fasilitas',
  },
];
---

<BaseLayout title="Pengumuman" active="blog">
  <section class="page-hero section-white">
    <div class="wrap">
      <p class="page-hero__kicker text-soft">Papan Informasi</p>
      <h1 class="page-hero__title">Pengumuman Warga</h1>
      <p class="page-hero__lede text-soft">
        Kabar dan informasi resmi dari pengurus RT Perum Asabri Bumiayu Indah untuk seluruh warga.
      </p>
    </div>
  </section>

  <section class="section-paper band">
    <div class="wrap card-grid">
      {pengumuman.map((item) => <InfoCard {...item} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 7vw, 4.5rem) 2.5rem;
  }
  .page-hero__kicker {
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  .page-hero__title {
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }
  .page-hero__lede {
    font-size: 1.08rem;
    max-width: 58ch;
  }
  .band {
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  @media (max-width: 860px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
