# ---------------------------------------------------------------------------
# SIWarga — Docker environment configuration
#
# Dipakai oleh docker-compose.yml (development) dan docker-compose.prd.yml
# (production). Salin file ini ke .env lalu sesuaikan nilainya:
#
#   cp .env.example .env
#
# Catatan: file ini TIDAK menggantikan src/backend/.env atau
# src/frontend/.env — kedua file itu tetap dipakai untuk workflow native
# (tanpa Docker) yang dijelaskan di README.md.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=SIWarga
APP_ENV=local
# Generate dengan: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Port yang di-expose ke host machine ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=8080
DB_PORT=3306

# --- Database (dipakai bersama oleh service backend & db) ---
DB_DATABASE=siwarga
DB_USERNAME=siwarga
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

# --- WAHA (WhatsApp gateway) ---
WAHA_PORT=3000
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_NO_API_KEY=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=secret

# --- Frontend ---
# VITE_API_URL: dev dipakai langsung oleh Vite dev server (runtime),
# prod di-bake saat build image (build arg), jadi rebuild frontend
# kalau nilai ini berubah untuk production.
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false
